# Copy these variables into your hosting provider's Environment Variables / Secrets.
# Never commit real tokens or passwords to GitHub.

# Telegram bot token from @BotFather (set the NEW token after rotating the exposed one).
TELEGRAM_BOT_TOKEN=

# Telegram destination chat ID for admin notifications (numeric user/group ID).
ADMIN_CHAT_ID=

# Optional per-salon override; replace ROZMARY with the uppercase client ID prefix.
# ROZMARY_ADMIN_CHAT_ID=
